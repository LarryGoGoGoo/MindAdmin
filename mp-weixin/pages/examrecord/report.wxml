<view class="report-page data-v-4408224a"><view class="summary-card data-v-4408224a"><view class="label data-v-4408224a">测评结果</view><view class="paper-name data-v-4408224a">{{report.papername||'心理测评'}}</view><view class="score-row data-v-4408224a"><view class="data-v-4408224a"><view class="score data-v-4408224a">{{displayScore}}</view><view class="score-label data-v-4408224a">{{isScl90?'总均分':'综合指数'}}</view></view><view class="{{['status','data-v-4408224a',(isWarning)?'warning':'']}}">{{isWarning?'需关注':'状态平稳'}}</view></view></view><block wx:if="{{isScl90}}"><view class="chart-card data-v-4408224a"><view class="section-title data-v-4408224a">九大因子雷达图</view><qiun-data-charts vue-id="3cfca7fc-1" type="radar" chartData="{{radarData}}" opts="{{radarOpts}}" canvasId="scl90Radar" class="data-v-4408224a" bind:__l="__l"></qiun-data-charts></view></block><block wx:if="{{isScl90}}"><view class="chart-card data-v-4408224a"><view class="section-title data-v-4408224a">因子得分</view><qiun-data-charts vue-id="3cfca7fc-2" type="column" chartData="{{columnData}}" opts="{{columnOpts}}" canvasId="scl90Column" class="data-v-4408224a" bind:__l="__l"></qiun-data-charts></view></block><block wx:if="{{isScl90}}"><view class="advice-card data-v-4408224a"><view class="section-title data-v-4408224a">分析与指导建议</view><view class="metric-grid data-v-4408224a"><view class="metric-item data-v-4408224a"><view class="metric-value data-v-4408224a">{{result.totalScore}}</view><view class="metric-label data-v-4408224a">总分</view></view><view class="metric-item data-v-4408224a"><view class="metric-value data-v-4408224a">{{result.positiveItemCount}}</view><view class="metric-label data-v-4408224a">阳性项目数</view></view><view class="metric-item data-v-4408224a"><view class="metric-value data-v-4408224a">{{result.positiveAverageScore}}</view><view class="metric-label data-v-4408224a">阳性均分</view></view></view><block wx:if="{{$root.g0===0}}"><view class="plain-tip data-v-4408224a">各因子均未超过预警阈值，建议继续保持规律作息、稳定运动和良好社会支持。</view></block><block wx:for="{{warningFactors}}" wx:for-item="factor" wx:for-index="__i0__" wx:key="key"><view class="advice-item data-v-4408224a"><view class="advice-title data-v-4408224a">{{factor.name+"："+factor.score}}</view><view class="advice-text data-v-4408224a">{{factor.guidance}}</view></view></block></view></block><block wx:if="{{!isScl90}}"><view class="chart-card data-v-4408224a"><view class="section-title data-v-4408224a">测评概览</view><qiun-data-charts vue-id="3cfca7fc-3" type="column" chartData="{{generalColumnData}}" opts="{{generalColumnOpts}}" canvasId="generalReportColumn" class="data-v-4408224a" bind:__l="__l"></qiun-data-charts></view></block><block wx:if="{{!isScl90}}"><view class="advice-card data-v-4408224a"><view class="section-title data-v-4408224a">心理分析</view><view class="metric-grid data-v-4408224a"><view class="metric-item data-v-4408224a"><view class="metric-value data-v-4408224a">{{report.score||0}}</view><view class="metric-label data-v-4408224a">综合指数</view></view><view class="metric-item data-v-4408224a"><view class="metric-value data-v-4408224a">{{report.answeredCount||report.recordCount||0}}</view><view class="metric-label data-v-4408224a">完成题目</view></view><view class="metric-item data-v-4408224a"><view class="metric-value data-v-4408224a">{{generalCompletion+"%"}}</view><view class="metric-label data-v-4408224a">完成度</view></view></view><view class="plain-tip data-v-4408224a">{{generalAdvice}}</view></view></block><view class="bottom-actions data-v-4408224a"><button data-event-opts="{{[['tap',[['backToList',['$event']]]]]}}" class="primary-btn data-v-4408224a" bindtap="__e">返回报告列表</button></view></view>